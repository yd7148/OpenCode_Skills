{
  "$schema": "https://opencode.ai/config.json",

  // Session 名稱自動產生（0 Token、純規則式、與模型無關）
  // 註：修正 opencode/big-pickle 供應商下的自動命名 bug（issue #30662）。
  // 對應 skill：opencode-session-auto-name
  //
  // 2026-11-11 修正：改用本 repo 自建的 V2 版 plugin。
  // 原 npm 套件 opencode-auto-name v0.1.3 是 V1 格式
  // （export default 為 function），V2 要求 default export 為帶 id 與 setup 的物件，
  // 自 2026-10-05 起已連續失敗 2386 次且從未成功載入。
  // 本機以 ~/.config/opencode/plugins/opencode-auto-name/ 承載移植版（零相依純物件 export）。
  //
  // Browser Control：以 MCP 伺服器方式註冊（2026-11-11 修正）
  // 原因：npm 套件 @opencode-ai/browser-control 0.8.4 的 dist/index.js
  //       不含 plugin 入口（上游 src/opencode.ts 的對應 changeset 尚未發布，
  //       且上游 repo 已於 2026-11-07 封存）。直接宣告 plugin 會導致
  //       「Plugin must export a default definition with an id and an effect
  //       or setup function」而載入失敗。
  // 改以 mcp.servers 手動註冊 browser-control-mcp，行為與 plugin 內
  //       mcpServerConfig() 完全相同。
  // 需求：Node.js >= 22.19，Chromium 家族瀏覽器並載入 unpacked extension。
  //
  // 注意：`plugin`（單數）為 V1 舊欄位，V2 schema 已標記 deprecated；
  //       一律使用 `plugins`（複數）。
  // `plugins` 的 V2 格式為字串或 { package, options } 物件；
  // V1 的 ["名稱", {選項}] tuple 形式會被判定為 malformed。
  //
  // session-auto-name 於 ~/.config/opencode/plugins/ 下，由 OpenCode 自動載入，
  // 不需在此宣告（宣告反而會重複載入 —— 本機有兩份 symlink 指向同一設定檔，
  // 相對路徑會被各自解析成不同絕對路徑而載入兩次）。
  "plugins": [],

  // 啟用語言伺服器（需設定環境變數 OPENCODE_EXPERIMENTAL_LSP_TOOL=true 才啟用 opencode 的 lsp 工具）。
  // "lsp": {
  //   "typescript": { "command": ["typescript-language-server", "--stdio"] },
  //   "pyright": { "command": ["pyright-langserver", "--stdio"] },
  //   "yaml": { "command": ["yaml-language-server", "--stdio"] },
  //   "bash": { "command": ["bash-language-server", "start"] }
  // },

  // 預設放行常用工具；個別機密操作仍需人工確認。
  // 完整環境記錄見 LOCAL-ENVIRONMENT.md。
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "bash", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "write", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" }
  ],

  // MCP 伺服器
  //
  // browser_control：Browser Control 官方 MCP（Playwright + relay + extension）。
  //   以 mcp.servers 註冊（2026-11-11 修正，取代失效的 plugin 入口）。
  //   套件：npm i -g @opencode-ai/browser-control（skill：browser-control）
  //
  // open-computer-use：以 UIA 驅動 Windows 桌面應用（適合 agent 無法用瀏覽器完成的工作）。
  //   套件：npm i -g open-computer-use（skill：open-computer-use）
  //
  // chrome-devtools：開發者工具（需先以 --remote-debugging-port=9222 啟動 Chrome；
  //   參見 browser-control SKILL.md 的「Chrome 遠端除錯」段落）。
  //   注意：此 MCP 不可與 Playwright MCP 同時使用同一個 profile
  //   （Chrome profile 一次只能被一個實例鎖定）。
  "mcp": {
    "servers": {
      "browser_control": {
        "type": "local",
        "command": ["browser-control-mcp"]
      },
      "open-computer-use": {
        "type": "local",
        "command": ["open-computer-use", "mcp"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"]
      }
    }
  }

  // 全域指令檔（掛載 ~/.config/opencode/AGENTS.md）：
  // "instructions": ["AGENTS.md"]
}
